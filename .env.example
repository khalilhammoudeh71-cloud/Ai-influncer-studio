# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

SESSION_SECRET=your-session-secret-here

# Authentication
# Mock authentication is intended only for local development. Never enable it
# in a production deployment.
ALLOW_MOCK_AUTH=false
VITE_ALLOW_MOCK_AUTH=false
CREATOR_EMAIL=creator@example.com
# Set this once to the intended Supabase user ID to import legacy browser data
# into that user's scoped cache. Legacy keys are preserved.
VITE_LEGACY_LOCAL_DATA_OWNER_ID=
# Optional local-only JSON fallback. Production always uses the database.
ALLOW_LOCAL_FILE_STORAGE=false
ALLOW_MOCK_BILLING=false

# OpenAI Integrations
Openai_api_key=sk-proj-your-openai-key-here
# AI_INTEGRATIONS_OPENAI_BASE_URL=

# Gemini Integrations
Gemini_api_key=your-gemini-api-key-here
# AI_INTEGRATIONS_GEMINI_BASE_URL=

# Wavespeed API
WAVESPEED_API_KEY=your-wavespeed-api-key-here

# Venice AI API
Veniceai_api_key=your-venice-api-key-here

# ElevenLabs API
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

SUPABASE_URL=https://your-project.supabase.co/
SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_URL=https://your-project.supabase.co/
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Additional provider credentials used by server-side generation features
RUNWARE_API_KEY=your-runware-api-key-here
WIRO_API_KEY=your-wiro-api-key-here
WIRO_API_SECRET=your-wiro-api-secret-here
