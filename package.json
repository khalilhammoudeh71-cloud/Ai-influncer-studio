{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test server/*.test.ts",
    "build:api": "esbuild scripts/api-source.ts --bundle --platform=node --format=esm --outfile=api/index.mjs --target=node20 --minify --external:@neondatabase/serverless --external:ws --external:dotenv --external:express --external:cors --external:openai --external:@google/genai --external:drizzle-orm --external:drizzle-zod --external:zod --external:p-limit --external:p-retry --external:ffmpeg-static --external:@ffmpeg-installer/ffmpeg",
    "vercel-build": "npm run build && npm run build:api",
    "preview": "vite preview",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "@google/genai": "^1.46.0",
    "@neondatabase/serverless": "^1.0.2",
    "@supabase/supabase-js": "^2.105.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.20.0",
    "@vercel/node": "^5.8.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "heic-convert": "^2.1.0",
    "instagram-url-direct": "^2.0.7",
    "jimp": "^1.6.1",
    "lucide-react": "^0.575.0",
    "openai": "^6.32.0",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
    "pg": "^8.21.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hot-toast": "^2.6.0",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "wiro-ai-sdk": "^0.1.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "^0.28.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vite-plugin-singlefile": "2.3.0"
  }
}
